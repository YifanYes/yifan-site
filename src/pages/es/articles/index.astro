---
import { getCollection } from 'astro:content';
import LocalizedArchivePage from '../../../components/LocalizedArchivePage.astro';
import Layout from '../../../layouts/Layout.astro';
import { byNewestEntry, toArchiveItem } from '../../../lib/archive-items';
import { ARCHIVE_COPY } from '../../../lib/ui';

const locale = 'es';
const copy = ARCHIVE_COPY[locale].articles;
const entries = await getCollection(
	'articles',
	({ data }) => !data.draft && data.locale === locale,
);
const items = entries.sort(byNewestEntry).map(toArchiveItem);
---

<Layout title={copy.metaTitle} description={copy.description} locale={locale} path="/es/articles/">
	<LocalizedArchivePage
		locale={locale}
		{...copy}
		items={items}
	/>
</Layout>
